# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python virtual environments
venv/
env/
ENV/
.venv

# Data files (too large for git)
*.csv
*.json
*.parquet
data/raw/
data/processed/
data/MNIST/
notebooks/data/

# Exclude model files
*.pkl
*.h5
*.pth
*.pt
models/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Distribution / packaging
dist/
build/
*.egg-info/

# Agent working state stays local and is never tracked, at any depth.
# CI (scripts/ci/check-tracked-paths.sh) refuses a push that tracks any of these.
CONSCIOUSNESS/
.claude/
chats/
